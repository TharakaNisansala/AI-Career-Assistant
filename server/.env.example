PORT=5000
# Pooler connection (PgBouncer, transaction mode) -- used by the app's runtime
# Pool in src/config/database.js for normal request-time queries.
DATABASE_URL=postgresql://postgres.qblyqgccdmrtwiunxzru:<your_password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# Direct connection (no PgBouncer) -- used only by scripts/migrate.js.
# PgBouncer's transaction pooling mode doesn't reliably support the prepared
# statements / session-level DDL that node-pg-migrate needs, so migrations
# must bypass the pooler and connect straight to Postgres on port 5432.
DIRECT_URL=postgresql://postgres:<your_password>@db.qblyqgccdmrtwiunxzru.supabase.co:5432/postgres
JWT_SECRET=<random-long-secret-string>
# Short-lived access token; POST /auth/refresh (backed by the longer-lived
# httpOnly refresh cookie below) mints a new one without re-entering a password.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Comma-separated list of origins allowed to call the API (CORS)
CLIENT_URL=http://localhost:5180

# Resume upload storage (Day 11)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads/resumes
MAX_RESUME_FILE_SIZE_MB=5

# AI service integration (Day 13)
# AI_PROVIDER selects the provider module in services/ai/providers/; the
# AI_API_KEY/AI_MODEL/AI_API_BASE_URL/AI_REQUEST_TIMEOUT_MS vars below are
# shared across all providers (only one is active at a time), not
# provider-namespaced.
AI_PROVIDER=anthropic
AI_API_KEY=<your-ai-provider-api-key>
AI_MODEL=claude-sonnet-5
AI_REQUEST_TIMEOUT_MS=30000
# Optional: override the provider's API base URL (proxies, testing)
# AI_API_BASE_URL=https://api.anthropic.com

# To use Groq's free-tier API instead (OpenAI-compatible chat completions):
# AI_PROVIDER=groq
# AI_API_KEY=<your-groq-api-key>
# AI_MODEL=openai/gpt-oss-120b
# AI_API_BASE_URL defaults to https://api.groq.com/openai/v1 -- no need to set it